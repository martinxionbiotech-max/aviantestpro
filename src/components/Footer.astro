    <div class="footer-col">
      <h2>Language</h2>
      <nav aria-label="Language switcher">
        {
          languages.map((l) => (
            <a
              href={langPath(l.code)}
              lang={l.code}
              class={l.code === (isLangPage ? currentLang : "en") ? "lang-active" : undefined}
            >
              {l.flag} {l.name}
