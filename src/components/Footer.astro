// 反向映射：URL slug -> en_slug
const SLUG_TO_EN: Record<string, string> = {};
for (const enSlug of Object.keys(LANG_ALL_SLUGS)) {
  SLUG_TO_EN[enSlug] = enSlug;
  for (const lg of LANG_CODES) {
    const loc = LANG_ALL_SLUGS[enSlug]?.[lg];
    if (loc) SLUG_TO_EN[loc] = enSlug;
  }
}

function footerHref(key: string) {
  const slug = isLangPage ? (FOOTER_SLUGS[currentLang]?.[key] ?? key) : key;
  return isLangPage ? `/${currentLang}/${slug}/` : `/${slug}/`;
}

// 当前页去掉语言前缀的路径
const pathWithoutLang = isLangPage
  ? Astro.url.pathname.replace(/^\/[a-z]{2}\//, "/") || "/"
  : Astro.url.pathname;

// 从当前路径解析出英文 slug，再映射到目标语言本地化 slug
function langPath(code: string) {
  let slug = pathWithoutLang.replace(/^\//, "").replace(/\/$/, "");
  try {
    slug = decodeURIComponent(slug);
  } catch (e) {
    // ignore malformed encoding
  }
  if (!slug) {
    return code === "en" ? "/" : `/${code}/`;
  }
  const enSlug = SLUG_TO_EN[slug] ?? slug;
  if (code === "en") {
    return `/${enSlug}/`;
  }
  const loc = LANG_ALL_SLUGS[enSlug]?.[code] ?? enSlug;
  return `/${code}/${loc}/`;
}
