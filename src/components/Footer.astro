---
const year = new Date().getFullYear();
const currentLang = Astro.url.pathname.split("/")[1];
const LANG_CODES = ["ar", "ja", "ko", "es", "fr", "de"];
const isLangPage = LANG_CODES.includes(currentLang);
const prefix = isLangPage ? `/${currentLang}` : "";

const languages = [
  { code: "en", name: "English", flag: "🇬🇧" },
  { code: "ar", name: "العربية", flag: "🇸🇦" },
  { code: "ja", name: "日本語", flag: "🇯🇵" },
  { code: "ko", name: "한국어", flag: "🇰🇷" },
  { code: "es", name: "Español", flag: "🇪🇸" },
  { code: "fr", name: "Français", flag: "🇫🇷" },
  { code: "de", name: "Deutsch", flag: "🇩🇪" },
];

// 当前页去掉语言前缀的路径
const pathWithoutLang = isLangPage
  ? Astro.url.pathname.replace(/^\/[a-z]{2}\//, "/") || "/"
  : Astro.url.pathname;

function langPath(code: string) {
  if (code === "en") return pathWithoutLang;
  return `/${code}${pathWithoutLang === "/" ? "/" : pathWithoutLang}`;
}
---

