---

<header class="site-header">
  <div class="container header-inner">
    <a href={`${prefix}/`} class="brand" aria-label="SENO INTERNATIONAL AVIAN GENETIC TEST — Home">
      <img src="/images/logo1.jpg" alt="" width="42" height="42" />
      <span class="brand-text">SENO INTERNATIONAL<br />AVIAN GENETIC TEST</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={`${prefix}${item.href}`}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={isActive(item.href) ? "active" : undefined}
          >
            {labels[item.key]}
          </a>
        ))
      }
    </nav>
  </div>
</header>
