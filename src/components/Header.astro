---
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const navItems = [
  { href: "/about-us/", label: "About" },
  { href: "/racing-pigeon-performance-dna-test/", label: "Racing Pigeon Performance DNA Test" },
  { href: "/avian-virus-rt-pcr-test/", label: "Avian Virus qPCR Test" },
  { href: "/avian-gender-dna-test/", label: "Avian Gender DNA Test" },
  { href: "/pigeon-dna-fingerprinting/", label: "Pigeon DNA Fingerprinting" },
  { href: "/build-avian-dna-test-lab/", label: "Build Avian DNA Test Lab" },
  { href: "/become-an-agent/", label: "Become An Agent" },
  { href: "/avian-dna-test-kits/", label: "Avian DNA Test Research Kits" },
  { href: "/articles/", label: "Articles" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="SENO INTERNATIONAL AVIAN GENETIC TEST — Home">
      <img src="/images/logo1.jpg" alt="" width="42" height="42" />
      <span class="brand-text">SENO INTERNATIONAL<br />AVIAN GENETIC TEST</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={isActive(item.href) ? "active" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
