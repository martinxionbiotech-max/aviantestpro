---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Fast, accurate, and affordable bird DNA testing services backed by 15 years of molecular diagnostics expertise.",
  canonical,
  ogType = "website",
  ogImage = "/images/logo1.jpg",
  jsonLd,
  author,
  datePublished,
  dateModified,
  noindex = false,
} = Astro.props;

const SITE = "https://aviantestpro.com";
const BRAND = "SENO INTERNATIONAL AVIAN GENETIC TEST";
const BRAND_SHORT = "SENO Avian Genetic Test";

// 标题规范化：去掉零宽空格；截断超长标题；品牌后缀用 | 分隔且判重
const cleanTitle = title.replace(/\u200b/gi, "").trim();
const hasBrand = cleanTitle.toUpperCase().includes("SENO") || cleanTitle.includes("AviantestPro");
const baseTitle = cleanTitle || BRAND;
const fullTitle = hasBrand ? baseTitle : `${baseTitle} | ${BRAND_SHORT}`;

const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : SITE + canonical)
  : SITE + Astro.url.pathname;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// 文章页 Article schema（EEAT 核心：作者 + 发布日期 + 发布者）
const articleJsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: cleanTitle,
        description,
        image: ogImage.startsWith("http") ? ogImage : SITE + ogImage,
        author: author
          ? { "@type": "Organization", name: author, url: SITE }
          : { "@type": "Organization", name: "SENO Testing Center", url: SITE },
        publisher: { "@id": SITE + "/#organization" },
        datePublished: datePublished,
        dateModified: dateModified || datePublished,
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl }
      }
    : null;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE + "/#organization",
  "name": "SENO INTERNATIONAL AVIAN GENETIC TEST",
  "legalName": "ZHANGJIAKOU SENO TESTING CENTER CO., LTD",
  "url": SITE,
  "logo": SITE + "/images/logo1.jpg",
  "email": "info@senobiocorp.com",
  "telephone": "+86-13323237275",
  "duns": "84-655-4226",
  "foundingDate": "2011",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Floor 3, Building 3, Hebei Guokong Beifang Guigu High-Tech New Town, No.28, Zhanqian E. Street, Qiaodong District",
    "addressLocality": "Zhangjiakou",
    "addressRegion": "Hebei",
    "addressCountry": "CN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "info@senobiocorp.com",
    "telephone": "+86-13323237275",
    "areaServed": "Worldwide",
    "availableLanguage": ["English", "Chinese"]
  },
  "areaServed": "Worldwide",
  "knowsAbout": [
    "Avian DNA sexing",
    "Bird gender testing",
    "Racing pigeon performance DNA testing",
    "Avian virus qPCR testing",
    "Pigeon DNA fingerprinting",
    "PBFD testing",
    "Avian polyomavirus testing"
  ],
  "sameAs": [
    "https://www.facebook.com/profile.php?id=100086183041562",
    "https://www.instagram.com/senobiocorp/",
    "https://x.com/martinw13461856",
    "https://www.youtube.com/channel/UCZOyQrl2Io0NaJ-OXMCCNVA"
  ]
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE + "/#website",
  "url": SITE,
  "name": "SENO INTERNATIONAL AVIAN GENETIC TEST",
  "publisher": { "@id": SITE + "/#organization" }
};

// 面包屑
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE + "/"
    },
    ...(canonicalUrl !== SITE + "/"
      ? [
          {
            "@type": "ListItem",
            "position": 2,
            "name": cleanTitle,
            "item": canonicalUrl
          }
        ]
      : [])
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex" : "max-image-preview:large"} />
    {author && <meta name="author" content={author} />}

    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />

    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="icon" type="image/jpeg" href="/images/logo1.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {jsonLdArray.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
