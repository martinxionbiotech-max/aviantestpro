---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Contact Us",
  h1: "Contact Us",
  description: "Welcome to inquire about bird genetic testing, place orders, and explore agency partnerships.",
  canonical: "/contact/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en-US\" href=\"https://aviantestpro.com/contact/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://aviantestpro.com/contact/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://aviantestpro.com/ar/الاتصال/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://aviantestpro.com/ja/コンタクト/\" /> <link rel=\"alternate\" hreflang=\"ko-KR\" href=\"https://aviantestpro.com/ko/연락처/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://aviantestpro.com/ko/연락처/\" /> <link rel=\"alternate\" hreflang=\"es-ES\" href=\"https://aviantestpro.com/es/pongase-en-contacto-con/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://aviantestpro.com/es/pongase-en-contacto-con/\" /> <link rel=\"alternate\" hreflang=\"fr-FR\" href=\"https://aviantestpro.com/fr/contact/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://aviantestpro.com/fr/contact/\" /> <link rel=\"alternate\" hreflang=\"de-DE\" href=\"https://aviantestpro.com/de/kontakt/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://aviantestpro.com/de/kontakt/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://aviantestpro.com/contact/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="article">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    
    <div class="entry-content">
      <div class="contact-hero">
        <img src="/images/SENO-Biotech-office.jpg" alt="Zhangjiakou Seno Testing Center | Global Avians Genetic Test Services" width="1024" height="529" loading="lazy" decoding="async" />
        <div class="contact-hero-overlay">
          <p>Welcome to inquire about bird genetic testing, place orders, and explore agency partnerships.</p>
        </div>
      </div>

      <div class="consultant-row">
        <div class="consultant-card">
          <h3>Consultant: <strong>Martin.W</strong></h3>
          <p><strong>Email:</strong> <a href="mailto:martin@senobiocorp.com">martin@senobiocorp.com</a></p>
          <a class="wa-btn" href="https://wa.me/+8613323237275" target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <div class="consultant-card">
          <h3>Consultant: <strong>Aaron.W</strong></h3>
          <p><strong>Email:</strong> <a href="mailto:aaron@senobiocorp.com">aaron@senobiocorp.com</a></p>
          <a class="wa-btn" href="https://wa.me/+8613313137465" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>

      <div class="company-card">
        <h3>ZHANGJIAKOU SENO TESTING CENTER CO., LTD</h3>
        <p><strong>Phone:</strong> 0086 13323237275</p>
        <p><strong>Email:</strong> <a href="mailto:info@senobiocorp.com">info@senobiocorp.com</a></p>
        <p><strong>Address:</strong> Floor 3, Building 3, Hebei Guokong Beifang Guigu High-Tech New Town, No.28, Zhanqian E. Street, Qiaodong District Zhangjiakou, Hebei, China</p>
      </div>
    </div>
  </article>
</BaseLayout>
