const page = {
  title: "PCR vs qPCR in Bird DNA Testing: Which Method Fits the Question?",
  h1: "PCR vs qPCR in Bird DNA Testing: Which Method Fits the Question?",
  description: "Conventional PCR versus real-time qPCR in avian testing: what each method measures, where each fails, and how to match the chemistry to sexing, pathogen, and parentage questions.",
  canonical: "/pcr-vs-qpcr-bird-dna-testing/",
  author: "SENO Testing Center",
  date: "November 6, 2026",
