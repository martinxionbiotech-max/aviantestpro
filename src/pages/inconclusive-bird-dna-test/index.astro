const page = {
  title: "What an Inconclusive Bird DNA Test Means",
  h1: "What an Inconclusive Bird DNA Test Means",
  description: "Why bird DNA tests come back inconclusive, how that differs from a negative result, and what a laboratory and an owner should do next.",
  canonical: "/inconclusive-bird-dna-test/",
  author: "SENO Testing Center",
