  canonical: "/es/politica-de-privacidad/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en-US\" href=\"https://aviantestpro.com/privacy-policy/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://aviantestpro.com/privacy-policy/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://aviantestpro.com/ar/سياسة-الخصوصية-2/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://aviantestpro.com/ja/プライバシーポリシー-2/\" /> <link rel=\"alternate\" hreflang=\"ko-KR\" href=\"https://aviantestpro.com/ko/개인정보-보호정책-2/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://aviantestpro.com/ko/개인정보-보호정책-2/\" /> <link rel=\"alternate\" hreflang=\"es-ES\" href=\"https://aviantestpro.com/es/politica-de-privacidad/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://aviantestpro.com/es/politica-de-privacidad/\" /> <link rel=\"alternate\" hreflang=\"fr-FR\" href=\"https://aviantestpro.com/fr/politique-de-confidentialite/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://aviantestpro.com/fr/politique-de-confidentialite/\" /> <link rel=\"alternate\" hreflang=\"de-DE\" href=\"https://aviantestpro.com/de/datenschutzbestimmungen/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://aviantestpro.com/de/datenschutzbestimmungen/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://aviantestpro.com/privacy-policy/\" />";
---
<BaseLayout title={page.title} description={page.description} canonical={page.canonical} ogType="article" lang="es" dir="ltr" hreflang={hreflang}>
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<p><strong>Fecha de entrada en vigor:</strong> 8 de mayo de 2026<br><strong>Última actualización:</strong> 8 de mayo de 2026</p><p>Bienvenido a Aviantestpro (“la Compañía,” “nosotros,” “nuestro” o “nos”). Esta Política de Privacidad explica cómo recopilamos, usamos, divulgamos, procesamos y protegemos su información cuando accede o utiliza el sitio web, servicios, productos, aplicaciones, formularios, servicios de pruebas de laboratorio, sistemas de pedidos en línea, canales de atención al cliente y plataformas relacionadas operadas por Aviantestpro (colectivamente, los “Servicios”).</p><p>Esta Política de Privacidad está diseñada para cumplir con los estándares internacionales de privacidad y las regulaciones aplicables, incluyendo:</p><ul><li>Reglamento General de Protección de Datos (GDPR)</li><li>GDPR del Reino Unido</li><li>Ley de Privacidad del Consumidor de California (CCPA/CPRA)</li><li>Ley de Protección de Datos Personales de Singapur (PDPA)</li><li>Otras leyes internacionales de privacidad y protección al consumidor aplicables</li></ul><p>Al acceder o utilizar nuestros Servicios, usted reconoce que ha leído y comprendido esta Política de Privacidad.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>1. Quiénes Somos</h2><p>Aviantestpro proporciona servicios de pruebas de laboratorio, soluciones de pruebas genéticas, diagnósticos aviares, servicios de biología molecular, productos relacionados con investigación, consumibles de laboratorio, kits de pruebas, información científica y servicios relacionados de atención al cliente para clientes globales.</p><p>Si tiene alguna pregunta sobre esta Política de Privacidad o sus datos personales, puede contactarnos en:</p><p><strong>Correo electrónico:</strong> <a><span class=\"__cf_email__\" data-cfemail=\"d3b2b7bebabd93b2a5bab2bda7b6a0a7a3a1bcfdb0bcbe\">[email protected]</span></a><br><strong>Sitio web:</strong> <a>https://aviantestpro.com</a></p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>2. Información que Recopilamos</h2><p>Podemos recopilar las siguientes categorías de información dependiendo de cómo interactúe con nuestros Servicios.</p><h3>2.1 Información Personal que Usted Proporciona</h3><p>Podemos recopilar información que usted proporcione voluntariamente, incluyendo:</p><ul><li>Nombre completo</li><li>Nombre de la empresa u organización</li><li>Dirección de correo electrónico</li><li>Número de teléfono</li><li>Dirección de envío y facturación</li><li>País o región</li><li>Información relacionada con pagos</li><li>Detalles de envío al laboratorio</li><li>Comunicaciones de atención al cliente</li><li>Credenciales de inicio de sesión de cuenta</li><li>Información de pedidos y transacciones</li><li>Archivos, documentos, informes o información de muestras cargados</li></ul><h3>2.2 Información de Laboratorio y Pruebas</h3><p>Dependiendo de los servicios solicitados, podemos recopilar:</p><ul><li>Identificadores de muestras</li><li>Información de especies</li><li>Información diagnóstica</li><li>Datos de pruebas genéticas</li><li>Registros de resultados de laboratorio</li><li>Historial de pruebas y metadatos asociados</li></ul><p>Procesamos dicha información únicamente para fines legítimos de laboratorio, científicos, control de calidad, operativos, atención al cliente y regulatorios.</p><h3>2.3 Información Recopilada Automáticamente</h3><p>Cuando visita nuestro sitio web, podemos recopilar automáticamente cierta información técnica, incluyendo:</p><ul><li>Dirección IP</li><li>Tipo y versión del navegador</li><li>Identificadores de dispositivo</li><li>Sistema operativo</li><li>URLs de referencia</li><li>Comportamiento de interacción con el sitio web</li><li>Configuración de zona horaria</li><li>Fechas y horas de acceso</li><li>Cookies y datos de seguimiento</li></ul><h3>2.4 Cookies y Tecnologías de Seguimiento</h3><p>Podemos utilizar:</p><ul><li>Cookies</li><li>Píxeles</li><li>Herramientas de análisis</li><li>Tecnologías de seguimiento de sesión</li><li>Tecnologías publicitarias</li></ul><p>Estas tecnologías nos ayudan a:</p><ul><li>Mejorar la funcionalidad del sitio web</li><li>Analizar el rendimiento del sitio web</li><li>Comprender el comportamiento de los visitantes</li><li>Mejorar la experiencia del usuario</li><li>Prevenir fraudes y abusos</li><li>Entregar contenido de marketing relevante</li></ul><p>Puede deshabilitar las cookies a través de la configuración de su navegador. Sin embargo, algunas funciones del sitio web pueden no funcionar correctamente.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>3. Cómo Usamos Su Información</h2><p>Podemos utilizar la información recopilada para los siguientes fines:</p><ul><li>Proporcionar servicios de pruebas de laboratorio</li><li>Procesar pedidos y pagos</li><li>Entregar informes y resultados</li><li>Gestionar cuentas de clientes</li><li>Responder a consultas y solicitudes de soporte</li><li>Mejorar el rendimiento y la seguridad del sitio web</li><li>Realizar análisis e investigaciones</li><li>Cumplir obligaciones contractuales</li><li>Enviar notificaciones operativas</li><li>Enviar comunicaciones de marketing cuando lo permita la ley</li><li>Detectar fraudes, uso indebido o actividades no autorizadas</li><li>Cumplir con obligaciones legales y regulatorias</li><li>Proteger nuestros derechos legales e intereses comerciales</li></ul><p>Solo procesamos información personal cuando tenemos una base legal para hacerlo.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>4. Bases Legales para el Procesamiento (GDPR)</h2><p>Para usuarios ubicados en el Espacio Económico Europeo (EEE), Reino Unido o jurisdicciones similares, procesamos datos personales basándonos en uno o más de los siguientes fundamentos legales:</p><ul><li>Su consentimiento</li><li>Ejecución de un contrato</li><li>Cumplimiento de obligaciones legales</li><li>Intereses comerciales legítimos</li><li>Protección de intereses vitales</li><li>Fines científicos o relacionados con investigación cuando esté legalmente permitido</li></ul><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>5. Compartición y Divulgación de Información</h2><p>No vendemos información personal.</p><p>Podemos compartir información con:</p><ul><li>Procesadores de pago</li><li>Proveedores de envío y logística</li><li>Socios de laboratorio y proveedores de servicios técnicos</li><li>Proveedores de infraestructura de TI y alojamiento</li><li>Proveedores de análisis y seguridad</li><li>Autoridades regulatorias cuando sea legalmente requerido</li><li>Asesores profesionales, auditores o asesoría legal</li><li>Agencias gubernamentales o fuerzas del orden cuando lo exija la ley aplicable</li></ul><p>Se espera que todos los proveedores externos mantengan estándares apropiados de confidencialidad y seguridad.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>6. Transferencias Internacionales de Datos</h2><p>Debido a que Aviantestpro atiende a clientes internacionales, su información puede ser transferida y procesada en países fuera de su país de residencia.</p><p>Cuando lo exija la ley, implementamos salvaguardas apropiadas para las transferencias internacionales de datos, incluyendo:</p><ul><li>Cláusulas contractuales estándar</li><li>Acuerdos de procesamiento de datos</li><li>Mecanismos seguros de transferencia</li><li>Salvaguardas de seguridad comercialmente razonables</li></ul><p>Al utilizar nuestros Servicios, usted reconoce que su información puede ser transferida internacionalmente.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>7. Retención de Datos</h2><p>Conservamos la información personal solo durante el tiempo razonablemente necesario para:</p><ul><li>Proporcionar los servicios solicitados</li><li>Mantener registros de laboratorio</li><li>Cumplir obligaciones contractuales</li><li>Resolver disputas</li><li>Cumplir con requisitos legales, fiscales, contables o regulatorios</li><li>Proteger nuestros intereses comerciales legítimos</li></ul><p>Los períodos de retención pueden variar según la naturaleza de la información y las obligaciones legales aplicables.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>8. Seguridad de los Datos</h2><p>Implementamos salvaguardas técnicas, organizativas y administrativas comercialmente razonables diseñadas para proteger su información, incluyendo:</p><ul><li>Servidores seguros e infraestructura de alojamiento</li><li>Controles de acceso y sistemas de autenticación</li><li>Comunicaciones cifradas cuando corresponda</li><li>Medidas internas de confidencialidad</li><li>Monitoreo contra accesos no autorizados o uso indebido</li></ul><p>Sin embargo, ningún método de transmisión o almacenamiento es completamente seguro. Por lo tanto, no podemos garantizar una seguridad absoluta.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>9. Sus Derechos de Privacidad</h2><p>Dependiendo de su jurisdicción, usted puede tener los siguientes derechos:</p><ul><li>Acceder a su información personal</li><li>Corregir información inexacta</li><li>Solicitar la eliminación de su información</li><li>Restringir u oponerse al procesamiento</li><li>Retirar el consentimiento</li><li>Solicitar la portabilidad de los datos</li><li>Optar por no recibir ciertas comunicaciones de marketing</li><li>Presentar quejas ante las autoridades de supervisión correspondientes</li></ul><p>Para ejercer sus derechos, contacte:</p><p><strong>Correo electrónico:</strong> <a><span class=\"__cf_email__\" data-cfemail=\"68090c05010628091e0109061c0d1b1c181a07460b0705\">[email protected]</span></a></p><p>Podemos requerir verificación de identidad antes de procesar ciertas solicitudes.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>10. Derechos de Privacidad de California (CCPA/CPRA)</h2><p>Si usted es residente de California, puede tener derechos adicionales bajo la ley de California, incluyendo:</p><ul><li>Derecho a saber qué información personal se recopila</li><li>Derecho a solicitar la eliminación</li><li>Derecho a corregir información personal inexacta</li><li>Derecho a optar por no participar en ciertas prácticas de compartición de datos</li><li>Derecho a no ser discriminado por ejercer derechos de privacidad</li></ul><p>Aviantestpro no vende información personal según lo definido bajo la CCPA/CPRA.</p><p>Los residentes de California pueden enviar solicitudes de privacidad contactando:</p><p><strong>Correo electrónico:</strong> <a><span class=\"__cf_email__\" data-cfemail=\"8efefce7f8efedf7ceeff8e7efe0faebfdfafefce1a0ede1e3\">[email protected]</span></a></p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>11. Derechos GDPR y GDPR del Reino Unido</h2><p>Si usted se encuentra en el Espacio Económico Europeo o el Reino Unido, puede tener derechos bajo las leyes de protección de datos aplicables, incluyendo:</p><ul><li>Derecho de acceso</li><li>Derecho de rectificación</li><li>Derecho de supresión</li><li>Derecho a la limitación del procesamiento</li><li>Derecho a la portabilidad de los datos</li><li>Derecho de oposición</li><li>Derechos relacionados con la toma de decisiones automatizada</li></ul><p>También tiene derecho a presentar una queja ante su autoridad local de protección de datos.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>12. Comunicaciones de Marketing</h2><p>Podemos enviar boletines informativos, actualizaciones de productos, avisos técnicos, información promocional o contenido educativo cuando lo permita la ley.</p><p>Puede darse de baja en cualquier momento:</p><ul><li>Haciendo clic en el enlace de cancelación de suscripción en los correos electrónicos</li><li>Contactándonos directamente</li><li>Ajustando las preferencias de comunicación de la cuenta</li></ul><p>Las comunicaciones operativas o relacionadas con el servicio aún pueden enviarse cuando sea necesario.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>13. Servicios de Terceros y Enlaces Externos</h2><p>Nuestro sitio web puede contener enlaces a sitios web, aplicaciones o servicios de terceros.</p><p>No somos responsables de:</p><ul><li>Prácticas de privacidad de terceros</li><li>Contenido de sitios web externos</li><li>Medidas de seguridad de terceros</li><li>Actividades externas de manejo de datos</li></ul><p>Recomendamos a los usuarios revisar las políticas de privacidad de los servicios de terceros antes de interactuar con ellos.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>14. Privacidad de los Menores</h2><p>Nuestros Servicios no están destinados a menores de la edad requerida por la ley aplicable en su jurisdicción.</p><p>No recopilamos conscientemente información personal de menores sin la autorización legal apropiada.</p><p>Si cree que un menor nos ha proporcionado información personal, por favor contáctenos inmediatamente.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>15. Toma de Decisiones Automatizada</h2><p>Generalmente no utilizamos procesos de toma de decisiones totalmente automatizados que produzcan efectos legales o similares significativos en los usuarios.</p><p>Si esto cambia en el futuro, actualizaremos esta Política de Privacidad en consecuencia.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>16. Señales de No Rastrear</h2><p>Algunos navegadores ofrecen configuraciones de “No Rastrear”. Debido a que actualmente no existe un estándar universalmente aceptado para responder a dichas señales, nuestro sitio web puede no responder a todas las solicitudes de No Rastrear.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>17. Análisis de Sitio Web y Publicidad</h2><p>Podemos utilizar proveedores de análisis y publicidad de terceros, incluyendo servicios como:</p><ul><li>Google Analytics</li><li>Herramientas de Search Console</li><li>Herramientas de seguimiento de conversión publicitaria</li><li>Plataformas de monitoreo de rendimiento</li></ul><p>Estos servicios pueden utilizar cookies o tecnologías similares para recopilar información sobre las interacciones con el sitio web.</p><p>Los usuarios pueden gestionar las preferencias publicitarias a través de la configuración del navegador o la plataforma.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>18. Motores de Búsqueda y Rastreadores de IA</h2><p>El contenido público de nuestro sitio web puede ser indexado por:</p><ul><li>Motores de búsqueda</li><li>Sistemas de búsqueda de IA</li><li>Rastreadores automatizados</li><li>Tecnologías de indexación web</li></ul><p>El contenido del sitio web disponible públicamente puede aparecer en resultados de búsqueda, resúmenes generados por IA, bases de datos de indexación o sistemas de descubrimiento similares.</p><p>Los envíos privados de clientes, registros de laboratorio e información confidencial no se publican intencionalmente para indexación pública.</p><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><h2>19. Cambios a Esta Política de Privacidad</h2><p>Podemos actualizar esta Política de Privacidad periódicamente.</p><p>Cuando se realicen cambios, revisaremos</p><p></p></div>`} />
  </article>
</BaseLayout>
