const page = {
  title: "Failed Avian DNA Tests: Causes and Next Steps | SENO",
  h1: "Failed Avian DNA Tests: Causes and Next Steps",
  description: "How to classify a failed avian DNA test, separate sample from laboratory causes, plan a repeat, and decide when switching labs solves the real problem.",
