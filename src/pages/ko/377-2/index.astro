const page = {
  title: "비둘기 도파민 DRD4 수용체 검사란 무엇인가?",
  h1: "비둘기 도파민 DRD4 수용체 검사란 무엇인가?",
  description: "경주 비둘기를 위한 도파민 DRD4 수용체 검사의 원리, 평가하는 성능 특성, 그리고 SENO 연구소가 비둘기 사육에 이 유전자 마커를 적용하는 방식을 알아보세요.",
  canonical: "/ko/377-2/",
