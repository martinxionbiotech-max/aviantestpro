    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-meta">By SENO Avian Genetic Test <span>/ November 8, 2026</span></div>
    <div class="entry-content" set:html={articleHtml} />
  </article>
</BaseLayout>
