const page = {
  title: "False Positives and False Negatives in Bird DNA Testing",
  h1: "False Positives and False Negatives in Bird DNA Testing",
  description: "How contamination, non-specific amplification, allele dropout, heteroduplexes and inhibition produce wrong bird DNA results, and how a false result differs from an inconclusive one.",
  canonical: "/false-positive-false-negative-bird-dna-testing/",
  author: "SENO Testing Center",
  date: "November 6, 2026",
