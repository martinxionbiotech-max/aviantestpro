const page = {
  title: "PCR Positive and Negative Controls in Avian Testing | SENO",
  h1: "PCR Positive and Negative Controls in Avian Testing",
  description: "What positive, negative, extraction, inhibition and internal controls detect in avian PCR, how to read a failed control, and when to reject a run.",
  canonical: "/pcr-positive-negative-controls/",
  author: "SENO Avian Genetic Test",
  date: "November 22, 2026",
