  { slug: "comment-reconnaitre-le-sexe-dun-emeu", title: "Comment déterminer le sexe d'une émeu ?", date: "May 31, 2026" },
  { slug: "comment-tester-le-sexe-des-oiseaux-en-utilisant-la-methode-rt-pcr", title: "Comment testons-nous le sexe des oiseaux à l'aide de la méthode RT-PCR (vidéo complète)", date: "May 26, 2026" },
  { slug: "pcr-rt-vs-pcr-traditionnelle-dans-un-laboratoire-danalyse-dadn-doiseaux", title: "RT-PCR vs PCR traditionnel dans un laboratoire de tests ADN aviaire", date: "May 25, 2026" },
  { slug: "comment-fonctionne-le-test-pcr-de-la-plume-pour-la-pbfd-et-le-polyomavirus-aviaire", title: "Comment fonctionne le test PCR sur plumes pour la PBFD et le polyomavirus aviaire", date: "May 22, 2026" },
  { slug: "tester-ladn-dun-oiseau-a-la-maison-quel-materiel-et-quels-reactifs-sont-necessaires", title: "Test ADN d'oiseau à la maison : quel équipement et quels réactifs vous faut-il ?", date: "May 21, 2026" },
