const posts = [
  { slug: "how-capillary-electrophoresis-analysis-works-in-bird-sexing-and-parentage-testing", title: "Comment fonctionne l'analyse par électrophorèse capillaire dans le cadre du sexage des oiseaux et des tests de filiation", date: "August 27, 2026" },
