---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Articles",
  h1: "Articles",
  description: "Articles techniques sur le sexage ADN des oiseaux, les tests de maladies aviaires et la génétique des pigeons voyageurs du laboratoire SENO.",
