};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Combien de temps prend le sexage par ADN chez les oiseaux ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La plupart des laboratoires terminent les tests en 1 à 2 jours ouvrables après l'arrivée de l'échantillon. Le délai total, expédition internationale comprise, est généralement de 7 à 10 jours."
      }
    },
    {
      "@type": "Question",
      "name": "Une seule plume peut-elle être utilisée pour le sexage par ADN ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Oui, une seule plume fraîchement arrachée avec un follicule intact est suffisante. Cependant, il est recommandé d'envoyer 2 à 3 plumes par oiseau par mesure de sécurité."
      }
    },
    {
      "@type": "Question",
      "name": "Le sexage par ADN est-il douloureux pour l'oiseau ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Non. L'arrachage de plumes provoque un léger inconfort momentané comparable à un pincement rapide. Il est classé comme une procédure non invasive."
      }
