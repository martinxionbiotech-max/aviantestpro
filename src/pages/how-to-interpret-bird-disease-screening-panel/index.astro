const page = {
  title: "How to Read a Bird Screening Panel | SENO",
  h1: "How to Interpret a Bird Disease Screening Panel",
  description: "How to read an avian PCR panel report: Detected, Not Detected, Inconclusive and Invalid results, Ct values, false negatives and when to retest.",
  canonical: "/how-to-interpret-bird-disease-screening-panel/",
  author: "SENO Avian Genetic Test",
  date: "November 8, 2026",
