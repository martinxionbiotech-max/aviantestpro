const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can this DNA test predict racing winners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. This genetic test does not predict racing winners or guarantee championship performance. It provides reference information about inherited endurance-associated biological tendencies that may influence long-distance adaptation, recovery efficiency, and energy metabolism. Actual racing performance still depends heavily on training quality, loft management, health condition, nutrition, weather, race distance, and breeder experience."
      }
    },
    {
      "@type": "Question",
      "name": "What does “High Endurance-Associated Profile” mean?",
